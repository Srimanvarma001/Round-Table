# ---------------------------------------------------------------------------
# Round Table — environment. Copy to .env.local and fill in real values.
# Every variable is read through src/lib/config.ts and nowhere else.
# ---------------------------------------------------------------------------

# --- LLM provider (GLM only; every seat and the synthesis run on it) -------
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- Web search (Trend-Watcher seat) ---------------------------------------
TAVILY_API_KEY=
SEARCH_PROVIDER=tavily

# --- GitHub ingestion (Me Agent profile) -----------------------------------
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- Runtime ---------------------------------------------------------------
DATABASE_URL=file:./data/roundtable.db
APP_USER_ID=local-user

RUN_BUDGET_USD=1.00
RUN_MAX_TOKENS=250000
RUN_MAX_CALLS=60

LOG_LEVEL=info
MOCK_LLM=false
